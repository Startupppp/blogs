# Streamline OS blog admin. Copy to .env.local for development; set the same names in the host
# (Vercel) for deployment. Every value below is a placeholder, never a working credential.
# Validated on the first request by lib/server/env.ts; a missing or malformed value names itself.

# --- Origins -------------------------------------------------------------------------------
# This admin's own origin. Server Actions and route handlers reject other Origins.
ADMIN_ORIGIN=http://localhost:3100
# Auth.js callback base. trustHost is off, so this must be set wherever the admin runs.
AUTH_URL=http://localhost:3100
# Canonical public site. Article links and "view live" checks point here.
PUBLIC_SITE_ORIGIN=http://localhost:3000

# --- Existing backend: signed invalidation ------------------------------------------------
# POST endpoint on streamlineos-backend. Its BLOG_INVALIDATION_SECRET must equal this one.
BLOG_INVALIDATION_URL=http://localhost:1500/blog/internal/invalidate
BLOG_INVALIDATION_SECRET=replace-with-at-least-32-random-characters

# --- Database: the SAME database the backend migrates, via the scoped blog_admin_app role ---
# Provision the role with db/provision-editorial-role.sql. Never use the owner or app role here.
DATABASE_URL=postgres://blog_admin_app:password@localhost:5432/streamline
DATABASE_POOL_MAX=5
# require (default) for Neon/RDS; disable only for a local Postgres.
DATABASE_SSL=disable

# --- Auth: Google OAuth client for editors ---------------------------------------------------
# Redirect URI to register: ${AUTH_URL}/api/auth/callback/google
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_GOOGLE_ID=replace-me.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=replace-me

# --- Durable jobs: Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/jobs/run ---
CRON_SECRET=replace-with-at-least-32-random-characters

# --- Cloudflare R2: two DIFFERENT buckets on one account ------------------------------------
# S3 API endpoint: https://<account-id>.r2.cloudflarestorage.com
# Also read at BUILD time for the Content-Security-Policy connect-src.
R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
# true only for MinIO or another path-style S3 test server.
R2_FORCE_PATH_STYLE=false
# Private: originals and draft renditions. No public access, no custom domain.
R2_PRIVATE_BUCKET=streamline-blog-private
# Public: promoted renditions only, served by MEDIA_PUBLIC_ORIGIN.
R2_PUBLIC_BUCKET=streamline-blog-public
# HTTPS custom domain bound to R2_PUBLIC_BUCKET. Also read at BUILD time for img-src.
MEDIA_PUBLIC_ORIGIN=https://media.example.com

# --- Policy -------------------------------------------------------------------------------
# false restricts author/category management to admins.
PUBLISHERS_MANAGE_TAXONOMY=true
